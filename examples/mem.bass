; Utilizing memory addresses
; Memory addresses are just an index into a 
; preallocated pool much larger than the stack memory

move @250 #12
move r0 #12
mul @250 @250 r0
println @250

; The @r syntax can be used to access the memory address
; using the value stored in the register (indirect addressing)

move r0 #5
sub @r0 #30 #1
println @r0

; It can be used together with load/store to achieve another
; layer of indirection

move r5 #32
move @r5 #45
store @r5 #1000         ; equivalent to `move @45 #1000`
load r0 @r5
println r0


; Finally, store can also be used to directly write strings into
; memory, which can then be printed using printb and printbln
; They can also be accessed as individual bytes through other opcodes
;
; Just like load and store, printb and printbln treats the first operand
; as a memory address

move r0 #0
store r0 "hello world"  ; stores 'hello world' at memory address #0
printbln r0 #11

; Note that print works on ints (4 bytes) while printb works on a single byte
; So the following will not work, instead printing a number formed by
; packing the first 4 bytes of the string

println @r0

; Use printb/printbln with a length of 1 to print a single character

printbln r0 #1     ; prints 'h'

